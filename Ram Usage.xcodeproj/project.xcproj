{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "de",
      "fr",
      "nl",
      "ru",
      "tr",
      "uk",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/ScrechKit",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/SwiftyJSON/SwiftyJSON",
      "version": {
        "up-to-next-major-version": "5.0.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/LaunchAtLogin",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/TopScrech/SafariCover",
      "version": {
        "up-to-next-major-version": "1.0.0",
      },
    },
  ],
  "files": [
    { "path": "README.md" },
    { "path": "AGENTS.md" },
    {
      "kind": "folder",
      "path": "macOS",
      "target-membership": [
        "macOS",
      ],
      "membership-exceptions": [
        {
          "target": "macOS",
          "exclusions": [
            "macOS.plist",
          ],
        }, {
          "target": "iOS",
          "inclusions": [
            "AppIcon.icon",
            "Assets.xcassets",
            "Nav/AppContainer.swift",
          ],
        }, {
          "target": "Widgets",
          "inclusions": [
            "AppIcon.icon",
            "Assets.xcassets",
            "Model/MemoryUsage.swift",
            "Model/SwapUsage.swift",
            "RamVM.swift",
            "Utils/Double.swift",
            "Utils/versionAndBuild.swift",
          ],
        }, {
          "target": "Unit Tests",
          "inclusions": [
            "Model/MemoryUsage.swift",
            "Model/SwapUsage.swift",
            "RamVM.swift",
            "Utils/Double.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "iOS",
      "target-membership": [
        "iOS",
      ],
      "membership-exceptions": [
        {
          "target": "iOS",
          "exclusions": [
            "iOS.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Widgets",
      "target-membership": [
        "Widgets",
      ],
      "membership-exceptions": [
        {
          "target": "macOS",
          "inclusions": [
            "ExtraLargeRamSpec.swift",
            "RamSpec.swift",
          ],
        }, {
          "target": "Widgets",
          "exclusions": [
            "Widgets.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Widgets iOS",
      "target-membership": [
        "Widgets iOS",
      ],
      "membership-exceptions": [
        {
          "target": "Widgets",
          "inclusions": [
            "Localizable.xcstrings",
            "RefreshIntent.swift",
          ],
        }, {
          "target": "Widgets iOS",
          "exclusions": [
            "Widgets.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Unit Tests", "target-membership": [ "Unit Tests" ] },
    { "path": "LICENSE.txt" },
    {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        {
          "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework",
          "target-membership": [
            "Widgets/frameworks",
            "Widgets iOS/frameworks",
          ],
        }, {
          "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework",
          "target-membership": [
            "Widgets/frameworks",
            "Widgets iOS/frameworks",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Ram Usage.app", "id": "F3530C002C6C12E700FB8481", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Unit Tests.xctest", "id": "F3C778082C6E24A900E224EE", "type": "wrapper.cfbundle", "index": false },
