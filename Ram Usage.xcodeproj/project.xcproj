        { "path": "<PRODUCTS>/iOS.app", "id": "F3274EE72D6D348200A8445A", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Widgets iOS.appex", "id": "F376127F2D6DA688005C115C", "type": "wrapper.app-extension", "index": false },
